{
    "//": "PureOS Store manifest. Ships a prebuilt binary rather than compiling, since",
    "//2": "sm.puri.Sdk 44's rust-stable extension (22.08, rustc ~1.69) is far below this",
    "//3": "crate's real 1.91 floor (set by alloy). sm.puri.Platform 44 itself is not the",
    "//4": "problem: it ships GTK 4.10.1, libadwaita 1.3.1 and glibc 2.35, all comfortably",
    "//5": "above this app's floors. See docs/packaging.md.",
    "//6": "Each binary was built INSIDE sm.puri.Sdk 44 (so it links against its GTK/",
    "//7": "libadwaita/glibc, proven by installing and running the result), using an",
    "//8": "upstream Rust 1.98 toolchain in place of the SDK's own. Reproduce with",
    "//9": "scripts/pureos-binary-build.sh at the tag below; the sha256 of each binary is",
    "//10": "pinned in its source entry so a tampered download fails the build rather than",
    "//11": "silently installing.",
    "app-id": "io.github.BlockBreakersHQ.BlockWallet",
    "runtime": "sm.puri.Platform",
    "runtime-version": "44",
    "sdk": "sm.puri.Sdk",
    "command": "block_wallet",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.secrets"
    ],
    "modules": [
        {
            "name": "block-wallet",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 block_wallet /app/bin/block_wallet",
                "install -Dm644 data/io.github.BlockBreakersHQ.BlockWallet.desktop /app/share/applications/io.github.BlockBreakersHQ.BlockWallet.desktop",
                "install -Dm644 data/io.github.BlockBreakersHQ.BlockWallet.metainfo.xml /app/share/metainfo/io.github.BlockBreakersHQ.BlockWallet.metainfo.xml",
                "install -Dm644 data/icons/hicolor/64x64/apps/io.github.BlockBreakersHQ.BlockWallet.png /app/share/icons/hicolor/64x64/apps/io.github.BlockBreakersHQ.BlockWallet.png",
                "install -Dm644 data/icons/hicolor/128x128/apps/io.github.BlockBreakersHQ.BlockWallet.png /app/share/icons/hicolor/128x128/apps/io.github.BlockBreakersHQ.BlockWallet.png",
                "install -Dm644 data/icons/hicolor/256x256/apps/io.github.BlockBreakersHQ.BlockWallet.png /app/share/icons/hicolor/256x256/apps/io.github.BlockBreakersHQ.BlockWallet.png",
                "install -Dm644 LICENSE /app/share/licenses/$FLATPAK_ID/LICENSE",
                "mkdir -p /app/share/blockwallet",
                "cp -a Images /app/share/blockwallet/Images"
            ],
            "sources": [
                {
                    "//": "Source of the data files, and the commit each binary was built from.",
                    "type": "git",
                    "url": "https://github.com/BlockBreakersHQ/BlockWallet.git",
                    "tag": "v0.3.0",
                    "commit": "b55c7f86c8212847fc77459dda9d722816385fb5"
                },
                {
                    "type": "file",
                    "only-arches": ["aarch64"],
                    "url": "https://github.com/BlockBreakersHQ/BlockWallet/releases/download/v0.3.0/block_wallet-pureos-aarch64",
                    "sha256": "fd74ab1dd957a1a834acdacc861f36ba7dc4f47160e90ac5ae839d5462e41caa",
                    "dest-filename": "block_wallet"
                },
                {
                    "type": "file",
                    "only-arches": ["x86_64"],
                    "url": "https://github.com/BlockBreakersHQ/BlockWallet/releases/download/v0.3.0/block_wallet-pureos-x86_64",
                    "sha256": "5e424204dacb4fb3749a10fdbb8befdcaa0b7be9961e90ff908ab98039e770e8",
                    "dest-filename": "block_wallet"
                }
            ]
        }
    ]
}
